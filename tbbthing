        if not projectile or not projectile.Parent or not root or not root.Parent then
            activeProjectiles[projectile] = nil
            continue
        end

        local position = root.Position
        local targetPart = getNearestTarget(position)

        if targetPart and targetPart:IsA("BasePart") and targetPart.Parent then
            if projectile:IsA("Model") then
                projectile:PivotTo(targetPart.CFrame)
            else
                root.CFrame = targetPart.CFrame
            end
        end
    end
end)

