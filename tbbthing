-- Teleport Up Loop
task.spawn(function()
	while true do
		task.wait(0.2)
		for _, obj in ipairs(projectileFolder:GetChildren()) do
			if teleportUpProjectiles[obj.Name] then
				if obj:IsA("Model") then
					obj:PivotTo(obj:GetPivot() + Vector3.new(0, 500, 0))
				else
					local root = getProjectileRoot(obj)
					if root then
						root.CFrame = root.CFrame + Vector3.new(0, 500, 0)
					end
				end
			end
		end
	end
end)

-- Continuous God Mode Loop (Ensures HumanoidRootParts stay deleted)
task.spawn(function()
	while true do
		task.wait(0.2)
		if godModeActive then
			for _, npc in ipairs(friendlyFolder:GetChildren()) do
				if npc:IsA("Model") then
					removeFriendlyRoot(npc)
				end
			end
		end
	end
end)

--------------------------------------------------
-- MAIN ENGINE LOOP
--------------------------------------------------

RunService.Heartbeat:Connect(function()
	for projectile, root in pairs(activeProjectiles) do
		if not projectile or not projectile.Parent or not root or not root.Parent then
			activeProjectiles[projectile] = nil
			continue
		end

		local position = root.Position
		local targetPart = getNearestTarget(position)

		if targetPart and targetPart:IsA("BasePart") and targetPart.Parent then
			if projectile:IsA("Model") then
				projectile:PivotTo(targetPart.CFrame)
			else
				root.CFrame = targetPart.CFrame
			end
		end
	end
end)

