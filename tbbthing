	if desc:IsA("Model") or desc:IsA("Humanoid") then
		task.delay(0.1, function()
			local model = desc:IsA("Model") and desc or desc:FindFirstAncestorOfClass("Model")
			if model then setupNPC(model) end
		end)
	end
end)

enemyFolder.DescendantAdded:Connect(function(desc)
	if desc:IsA("Model") or desc:IsA("Humanoid") then
		task.delay(0.1, function()
			local model = desc:IsA("Model") and desc or desc:FindFirstAncestorOfClass("Model")
			if model then setupNPC(model) end
		end)
	end
end)

CollectionService:GetInstanceAddedSignal("Boss"):Connect(function(object)
	task.delay(0.1, function()
		if object:IsDescendantOf(enemyFolder) then setupNPC(object) end
	end)
end)

-- Process Projectiles
for _, obj in ipairs(projectileFolder:GetChildren()) do processProjectile(obj) end
projectileFolder.ChildAdded:Connect(processProjectile)

-- Teleport Up Loop
task.spawn(function()
	while true do
		task.wait(0.2)
		for _, obj in ipairs(projectileFolder:GetChildren()) do
			if teleportUpProjectiles[obj.Name] then
				if obj:IsA("Model") then
					obj:PivotTo(obj:GetPivot() + Vector3.new(0, 500, 0))
				else
					local root = getProjectileRoot(obj)
					if root then
						root.CFrame = root.CFrame + Vector3.new(0, 500, 0)
					end
				end
			end
		end
	end
end)

--------------------------------------------------
-- MAIN ENGINE LOOP
--------------------------------------------------

RunService.Heartbeat:Connect(function()
	for projectile, root in pairs(activeProjectiles) do
		if not projectile or not projectile.Parent or not root or not root.Parent then
			activeProjectiles[projectile] = nil
			continue
		end

		local position = root.Position
		local targetPart = getNearestTarget(position)

		if targetPart and targetPart:IsA("BasePart") then
			if projectile:IsA("Model") then
				projectile:PivotTo(targetPart.CFrame)
			else
				root.CFrame = targetPart.CFrame
			end
		end
	end
end)

--------------------------------------------------
-- TIMER SPAWN TRIGGER LOGIC (AUTO-RECONNECTING)
--------------------------------------------------

task.spawn(function()
	local localPlayer = Players.LocalPlayer or Players:GetPropertyChangedSignal("LocalPlayer"):Wait()
	local playerGui = localPlayer:WaitForChild("PlayerGui")

	local eventsFolder = ReplicatedStorage:WaitForChild("Events")
	local remoteFunctionFolder = eventsFolder:WaitForChild("RemoteFunction")
	local playerSpawnRemote = remoteFunctionFolder:WaitForChild("PlayerSpawn")

	local hasFired = false
	local currentConnection = nil

	local function hookTimerLabel()
		if currentConnection then
			currentConnection:Disconnect()
			currentConnection = nil
		end

		local battleScreen = playerGui:WaitForChild("BattleScreen", 10)
		if not battleScreen then return end

		local bankButton = battleScreen:WaitForChild("BankButton", 10)
		if not bankButton then return end

		local timerLabel = bankButton:WaitForChild("Timer", 10)
		if not timerLabel then return end

		local function checkTimer()
			if timerLabel.Text == "0:00" and not hasFired then
				hasFired = true
				
				local args = {
					[1] = "Bank"
				}
				playerSpawnRemote:InvokeServer(unpack(args))
			elseif timerLabel.Text ~= "0:00" then
				hasFired = false
			end
		end

		currentConnection = timerLabel:GetPropertyChangedSignal("Text"):Connect(checkTimer)
		
		timerLabel.Destroying:Once(function()
			if currentConnection then
				currentConnection:Disconnect()
				currentConnection = nil
			end
		end)

		checkTimer()
	end

	hookTimerLabel()

	playerGui.DescendantAdded:Connect(function(descendant)
		if descendant.Name == "Timer" and descendant:IsA("TextLabel") then
			task.delay(0.1, hookTimerLabel)
		end
	end)
end)
