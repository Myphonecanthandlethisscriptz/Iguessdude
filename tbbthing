local function createHPBar(npc, template, barName)
	if not template or not npc:IsA("Model") then return end

	local humanoid = npc:FindFirstChildOfClass("Humanoid") or npc:WaitForChild("Humanoid", 2)
	local head = npc:FindFirstChild("Head") or npc.PrimaryPart or npc:FindFirstChildWhichIsA("BasePart", false)

	if not humanoid or not head then return end
	if head:FindFirstChild(barName) then return end

	local hpBar = template:Clone()
	hpBar.Name = barName

	local billboard = hpBar:IsA("BillboardGui") and hpBar or hpBar:FindFirstChildWhichIsA("BillboardGui", true)
	if billboard then
		billboard.Adornee = head
		billboard.AlwaysOnTop = true
		billboard.StudsOffset = Vector3.new(0, 0, 0)
		billboard.Enabled = true
	end

	local bar = hpBar:FindFirstChild("Bar", true)
	local textLabel = hpBar:FindFirstChild("TextLabel", true)

	if not bar then
		hpBar:Destroy()
		return
	end

	hpBar.Parent = head
	local originalYScale = bar.Size.Y.Scale
	local originalYOffset = bar.Size.Y.Offset

	bar.AnchorPoint = Vector2.new(0, bar.AnchorPoint.Y)
	bar.Position = UDim2.new(0, 0, bar.Position.Y.Scale, bar.Position.Y.Offset)

	local function update()
		if not humanoid or not humanoid.Parent then return end
		local health = math.max(humanoid.Health, 0)
		local maxHealth = humanoid.MaxHealth

		if textLabel then textLabel.Text = string.format("%d/%d", math.floor(health), math.floor(maxHealth)) end

		if health <= 0 or maxHealth <= 0 then
			bar.Size = UDim2.new(0, 0, originalYScale, originalYOffset)
			if billboard then billboard.Enabled = false end
			return
		end

		if billboard then billboard.Enabled = true end
		local percentage = math.clamp(health / maxHealth, 0, 1)
		bar.Size = UDim2.new(percentage, 0, originalYScale, originalYOffset)
	end

	update()

	local connections = {}
	local function cleanup()
		for _, conn in ipairs(connections) do conn:Disconnect() end
		table.clear(connections)
		if hpBar and hpBar.Parent then hpBar:Destroy() end
	end

	table.insert(connections, humanoid.HealthChanged:Connect(update))
	table.insert(connections, humanoid.Died:Connect(cleanup))
	table.insert(connections, npc.Destroying:Connect(cleanup))
end

local function setupNPC(npc)
	if not npc:IsA("Model") then return end
	
	if npc:IsDescendantOf(enemyFolder) then
		createWaitToMoveUI(npc)
	elseif npc:IsDescendantOf(friendlyFolder) then
		removeFriendlyRoot(npc)
	end

	if CollectionService:HasTag(npc, "Boss") and npc:IsDescendantOf(enemyFolder) then
		createHPBar(npc, bossTemplate, "BossHPBar")
	elseif npc:IsDescendantOf(enemyFolder) then
		createHPBar(npc, enemyTemplate, "EnemyHPBar")
	elseif npc:IsDescendantOf(friendlyFolder) then
		createHPBar(npc, friendlyTemplate, "FriendlyHPBar")
	end
end

--------------------------------------------------
-- PROJECTILE LOGIC
--------------------------------------------------

local function handleProjectile(obj)
	if activeProjectiles[obj] then return end

	local root = getProjectileRoot(obj)
	if not root then return end

	activeProjectiles[obj] = root
	removeTouchInterests(obj)

	local attachment = root:FindFirstChild("SpinAttachment") or Instance.new("Attachment")
	attachment.Name = "SpinAttachment"
	attachment.Parent = root

	local angularVel = root:FindFirstChild("ProjectileSpin") or Instance.new("AngularVelocity")
	angularVel.Name = "ProjectileSpin"
	angularVel.Attachment0 = attachment
	angularVel.MaxTorque = 1000000
	angularVel.AngularVelocity = Vector3.new(-40, 0, 0)
	angularVel.RelativeTo = Enum.RelativeTo.World
	angularVel.Parent = root

	obj.Destroying:Once(function()
		activeProjectiles[obj] = nil
	end)
end

local function processProjectile(obj)
	task.defer(function()
		if not obj or not obj.Parent then return end

		if deleteProjectiles[obj.Name] == true then
			obj:Destroy()
		elseif validProjectiles[obj.Name] == true then
			handleProjectile(obj)
		end
	end)
end

