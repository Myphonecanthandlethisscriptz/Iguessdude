--------------------------------------------------
-- HP BAR
--------------------------------------------------

local function findChild(parent, name)
	return parent:FindFirstChild(name, true)
end


local function createHPBar(npc, template, barName)

	if not npc:IsA("Model") then
		return
	end

	local humanoid = npc:FindFirstChildOfClass("Humanoid")
	local head = npc:FindFirstChild("Head", true)

	if not humanoid or not head then
		return
	end

	--------------------------------------------------
	-- DON'T DUPLICATE
	--------------------------------------------------

	local oldBar = head:FindFirstChild(barName)

	if oldBar then
		oldBar:Destroy()
	end

	--------------------------------------------------
	-- CLONE
	--------------------------------------------------

	local hpBar = template:Clone()
	hpBar.Name = barName

	if hpBar:IsA("BillboardGui") then
		hpBar.Adornee = head
		hpBar.Enabled = true
	end

	hpBar.Parent = head

	--------------------------------------------------
	-- FIND UI
	--------------------------------------------------

	local bar = findChild(hpBar, "Bar")
	local textLabel = findChild(hpBar, "TextLabel")

	if not bar then
		warn(
			"HP bar is missing 'Bar':",
			template:GetFullName()
		)

		return
	end

	--------------------------------------------------
	-- ORIGINAL HEIGHT
	--------------------------------------------------

	local originalYScale = bar.Size.Y.Scale
	local originalYOffset = bar.Size.Y.Offset

	--------------------------------------------------
	-- SHRINK FROM LEFT
	--------------------------------------------------

	bar.AnchorPoint = Vector2.new(
		0,
		bar.AnchorPoint.Y
	)

	bar.Position = UDim2.new(
		0,
		0,
		bar.Position.Y.Scale,
		bar.Position.Y.Offset
	)

	--------------------------------------------------
	-- UPDATE HP
	--------------------------------------------------

	local function update()

		if not humanoid.Parent then
			return
		end

		local health = humanoid.Health
		local maxHealth = humanoid.MaxHealth

		--------------------------------------------------
		-- TEXT
		--------------------------------------------------

		if textLabel then

			textLabel.Text =
				math.floor(math.max(health, 0))
				.. "/"
				.. math.floor(maxHealth)

		end

		--------------------------------------------------
		-- DEAD
		--------------------------------------------------

		if health <= 0 or maxHealth <= 0 then

			bar.Size = UDim2.new(
				0,
				0,
				originalYScale,
				originalYOffset
			)

			if hpBar:IsA("BillboardGui") then
				hpBar.Enabled = false
			end

			return
		end

		--------------------------------------------------
		-- ALIVE
		--------------------------------------------------

		if hpBar:IsA("BillboardGui") then
			hpBar.Enabled = true
		end

		local percentage = math.clamp(
			health / maxHealth,
			0,
			1
		)

		bar.Size = UDim2.new(
			percentage,
			0,
			originalYScale,
			originalYOffset
		)

	end


	--------------------------------------------------
	-- INITIAL
	--------------------------------------------------

	update()


	--------------------------------------------------
	-- HEALTH CHANGED
	--------------------------------------------------

	humanoid.HealthChanged:Connect(update)


	--------------------------------------------------
	-- DIED
	--------------------------------------------------

	humanoid.Died:Connect(function()

		bar.Size = UDim2.new(
			0,
			0,
			originalYScale,
			originalYOffset
		)

		if hpBar:IsA("BillboardGui") then
			hpBar.Enabled = false
		end

	end)

end


--------------------------------------------------
-- SETUP NPC
--------------------------------------------------

local function setupNPC(npc)

	if not npc:IsA("Model") then
		return
	end

	if not npc:FindFirstChildOfClass("Humanoid") then
		return
	end

	--------------------------------------------------
	-- BOSS
	--------------------------------------------------

	if CollectionService:HasTag(npc, "Boss") then

		if npc:IsDescendantOf(enemyFolder) then

			createHPBar(
				npc,
				bossTemplate,
				"BossHPBar"
			)

		end

		return
	end

	--------------------------------------------------
	-- ENEMY
	--------------------------------------------------

	if npc:IsDescendantOf(enemyFolder) then

		createHPBar(
			npc,
			enemyTemplate,
			"EnemyHPBar"
		)

		return
	end

	--------------------------------------------------
	-- FRIENDLY
	--------------------------------------------------

	if npc:IsDescendantOf(friendlyFolder) then

		createHPBar(
			npc,
			friendlyTemplate,
			"FriendlyHPBar"
		)

	end

end


