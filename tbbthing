--------------------------------------------------
--================================================
-- PROJECTILE SYSTEM
--================================================
--------------------------------------------------

local projectileList = {}
local bodyAngularList = {}


--------------------------------------------------
-- GET PROJECTILE ROOT
--------------------------------------------------

local function getProjectileRoot(obj)

	if obj:IsA("BasePart") then
		return obj
	end

	if obj:IsA("Model") then

		if obj.PrimaryPart then
			return obj.PrimaryPart
		end

		return obj:FindFirstChildWhichIsA(
			"BasePart",
			true
		)

	end

	return obj:FindFirstChildWhichIsA(
		"BasePart",
		true
	)

end


--------------------------------------------------
-- GET PROJECTILE POSITION
--------------------------------------------------

local function getProjectilePosition(obj)

	if obj:IsA("BasePart") then
		return obj.Position
	end

	if obj:IsA("Model") then
		return obj:GetPivot().Position
	end

	local root = getProjectileRoot(obj)

	if root then
		return root.Position
	end

	return nil
end


--------------------------------------------------
-- REMOVE TOUCH INTERESTS
--------------------------------------------------

local function removeTouchInterests(obj)

	if obj:IsA("TouchInterest") then
		obj:Destroy()
		return
	end

	for _, descendant in ipairs(
		obj:GetDescendants()
	) do

		if descendant:IsA("TouchInterest") then
			descendant:Destroy()
		end

	end

end


--------------------------------------------------
-- GET NEAREST VALID NPC
--------------------------------------------------

local function getNearestNPC(position)

	local nearestNPC = nil
	local nearestDistance = math.huge

	for _, npc in ipairs(
		enemyFolder:GetChildren()
	) do

		local humanoid =
			npc:FindFirstChildOfClass("Humanoid")

		local root =
			npc:FindFirstChild(
				"HumanoidRootPart"
			)

		--------------------------------------------------
		-- FLYING NPCs ARE NEVER TARGETED
		--------------------------------------------------

		local isFlying =
			npc:GetAttribute("Flying") ~= nil

		if humanoid
			and humanoid.Health > 0
			and root
			and not isFlying then

			local distance =
				(
					root.Position
					- position
				).Magnitude

			if distance < nearestDistance then

				nearestDistance = distance
				nearestNPC = npc

			end

		end

	end

	return nearestNPC
end


--------------------------------------------------
-- FORCE MOVE PROJECTILE
--------------------------------------------------

local function forceMoveProjectile(
	obj,
	targetCFrame
)

	--------------------------------------------------
	-- BASEPART
	--------------------------------------------------

	if obj:IsA("BasePart") then

		obj.CFrame = targetCFrame

		return
	end

	--------------------------------------------------
	-- MODEL
	--------------------------------------------------

	if obj:IsA("Model") then

		obj:PivotTo(targetCFrame)

		return
	end

	--------------------------------------------------
	-- OTHER
	--------------------------------------------------

	local root = getProjectileRoot(obj)

	if root then
		root.CFrame = targetCFrame
	end

end


--------------------------------------------------
-- HANDLE PROJECTILE
--------------------------------------------------

local function handleProjectile(obj)

	if not obj or not obj.Parent then
		return
	end

	if projectileList[obj] then
		return
	end

	local root = getProjectileRoot(obj)

	if not root then
		return
	end

	projectileList[obj] = true

	--------------------------------------------------
	-- REMOVE TOUCH
	--------------------------------------------------

	removeTouchInterests(obj)

	--------------------------------------------------
	-- SPIN
	--------------------------------------------------

	local bav =
		root:FindFirstChildOfClass(
			"BodyAngularVelocity"
		)

	if not bav then

		bav = Instance.new(
			"BodyAngularVelocity"
		)

		bav.MaxTorque =
			Vector3.new(
				1e6,
				1e6,
				1e6
			)

		bav.AngularVelocity =
			Vector3.new(
				-40,
				0,
				0
			)

		bav.Parent = root

	end

	bodyAngularList[bav] = true

end


--------------------------------------------------
-- DELETE PROJECTILE
--------------------------------------------------

local function deleteProjectile(obj)

	if not obj or not obj.Parent then
		return
	end

	projectileList[obj] = nil

	obj:Destroy()

end


