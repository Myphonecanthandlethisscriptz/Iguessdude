--------------------------------------------------
-- PROJECTILE SYSTEM
--------------------------------------------------

local projectileList = {}
local bodyAngularList = {}

--------------------------------------------------
-- GET ROOT
--------------------------------------------------

local function getProjectileRoot(obj)
	if obj:IsA("BasePart") then
		return obj
	end

	if obj:IsA("Model") then
		if obj.PrimaryPart then
			return obj.PrimaryPart
		end

		return obj:FindFirstChildWhichIsA("BasePart", true)
	end

	return obj:FindFirstChildWhichIsA("BasePart", true)
end

--------------------------------------------------
-- GET POSITION
--------------------------------------------------

local function getProjectilePosition(obj)
	if obj:IsA("BasePart") then
		return obj.Position
	end

	if obj:IsA("Model") then
		return obj:GetPivot().Position
	end

	local root = getProjectileRoot(obj)

	if root then
		return root.Position
	end

	return nil
end

--------------------------------------------------
-- CHECK IF MOVING RIGHT
--------------------------------------------------

local function isFlyingRight(obj)
	local root = getProjectileRoot(obj)

	if not root then
		return false
	end

	return root.AssemblyLinearVelocity.X > 0
end

--------------------------------------------------
-- REMOVE TOUCH INTERESTS
--------------------------------------------------

local function removeTouchInterests(obj)
	if obj:IsA("TouchInterest") then
		obj:Destroy()
		return
	end

	for _, descendant in ipairs(obj:GetDescendants()) do
		if descendant:IsA("TouchInterest") then
			descendant:Destroy()
		end
	end
end

--------------------------------------------------
-- FIND NEAREST NPC
--------------------------------------------------

local function getNearestNPC(position)
	local nearestNPC = nil
	local nearestDistance = math.huge

	for _, npc in ipairs(enemyFolder:GetChildren()) do
		local humanoid = npc:FindFirstChildOfClass("Humanoid")
		local root = npc:FindFirstChild("HumanoidRootPart")

		local isFlying = npc:GetAttribute("Flying") ~= nil

		if humanoid
			and humanoid.Health > 0
			and root
			and not isFlying then

			local distance =
				(root.Position - position).Magnitude

			if distance < nearestDistance then
				nearestDistance = distance
				nearestNPC = npc
			end
		end
	end

	return nearestNPC
end

--------------------------------------------------
-- MOVE PROJECTILE
--------------------------------------------------

local function forceMoveProjectile(obj, targetCFrame)
	if obj:IsA("BasePart") then
		obj.CFrame = targetCFrame
		return
	end

	if obj:IsA("Model") then
		obj:PivotTo(targetCFrame)
		return
	end

	local root = getProjectileRoot(obj)

	if root then
		root.CFrame = targetCFrame
	end
end

--------------------------------------------------
-- DELETE PROJECTILE
--------------------------------------------------

local function deleteProjectile(obj)
	if not obj or not obj.Parent then
		return
	end

	projectileList[obj] = nil

	obj:Destroy()
end

--------------------------------------------------
-- HANDLE PROJECTILE
--------------------------------------------------

local function handleProjectile(obj)
	if not obj or not obj.Parent then
		return
	end

	if projectileList[obj] then
		return
	end

	local root = getProjectileRoot(obj)

	if not root then
		return
	end

	projectileList[obj] = true

	removeTouchInterests(obj)

	local bav = root:FindFirstChild("ProjectileSpin")

	if not bav then
		bav = Instance.new("BodyAngularVelocity")
		bav.Name = "ProjectileSpin"
		bav.MaxTorque = Vector3.new(
			1000000,
			1000000,
			1000000
		)

		bav.AngularVelocity = Vector3.new(
			-40,
			0,
			0
		)

		bav.Parent = root
	end

	bodyAngularList[bav] = true
end

--------------------------------------------------
-- INITIAL PROJECTILES
