local function createWaitToMoveUI(npc)
	if not npc:IsA("Model") then return end

	local head = npc:FindFirstChild("Head") 
		or npc.PrimaryPart 
		or npc:FindFirstChildWhichIsA("BasePart", false)

	if not head or head:FindFirstChild(UI_WAIT_TO_MOVE_NAME) then return end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = UI_WAIT_TO_MOVE_NAME
	billboard.Adornee = head
	billboard.Size = UDim2.new(0, 160, 0, 30)
	billboard.StudsOffset = Vector3.new(0, 4.5, 0)
	billboard.AlwaysOnTop = true
	billboard.Enabled = false

	local textLabel = Instance.new("TextLabel")
	textLabel.Size = UDim2.new(1, 0, 1, 0)
	textLabel.BackgroundTransparency = 1
	textLabel.TextColor3 = Color3.fromRGB(255, 230, 80)
	textLabel.TextStrokeTransparency = 0
	textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	textLabel.Font = Enum.Font.GothamBold
	textLabel.TextSize = 14
	textLabel.Parent = billboard

	billboard.Parent = head

	local connections = {}

	local function cleanup()
		for _, conn in ipairs(connections) do conn:Disconnect() end
		table.clear(connections)
		if billboard and billboard.Parent then billboard:Destroy() end
	end

	local function updateText()
		local waitValue = npc:GetAttribute("WaitToMove")
		if waitValue ~= nil then
			textLabel.Text = string.format("WaitToMove: %s", tostring(waitValue))
			billboard.Enabled = true
		else
			billboard.Enabled = false
		end
	end

	table.insert(connections, npc:GetAttributeChangedSignal("WaitToMove"):Connect(updateText))
	updateText()

	local humanoid = npc:FindFirstChildOfClass("Humanoid")
	if humanoid then
		table.insert(connections, humanoid.Died:Connect(cleanup))
	end
	table.insert(connections, npc.Destroying:Connect(cleanup))
end

