--------------------------------------------------
-- FIND NEAREST NON-FLYING NPC
--------------------------------------------------

local function getNearestNPC(position)

    local nearestNPC = nil
    local nearestDistance = math.huge

    for _, npc in ipairs(enemyFolder:GetChildren()) do

        local humanoid = npc:FindFirstChild("Humanoid")
        local root = npc:FindFirstChild("HumanoidRootPart")

        -- The existence of the Flying attribute is enough
        -- to make this NPC invalid as a target.
        local isFlying = npc:GetAttribute("Flying") ~= nil

        if humanoid
            and humanoid.Health > 0
            and root
            and not isFlying then

            local distance = (
                root.Position - position
            ).Magnitude

            if distance < nearestDistance then

                nearestDistance = distance
                nearestNPC = npc

            end
        end
    end

    return nearestNPC
end

--------------------------------------------------
-- GET PROJECTILE ROOT PART
--------------------------------------------------

local function getProjectileRoot(obj)

    if obj:IsA("BasePart") then
        return obj
    end

    if obj:IsA("Model") then

        if obj.PrimaryPart then
            return obj.PrimaryPart
        end

        return obj:FindFirstChildWhichIsA(
            "BasePart",
            true
        )
    end

    return obj:FindFirstChildWhichIsA(
        "BasePart",
        true
    )
end

--------------------------------------------------
-- GET PROJECTILE POSITION
--------------------------------------------------

local function getProjectilePosition(obj)

    if obj:IsA("BasePart") then
        return obj.Position
    end

    if obj:IsA("Model") then
        return obj:GetPivot().Position
    end

    local root = getProjectileRoot(obj)

    if root then
        return root.Position
    end

    return nil
end

--------------------------------------------------
-- FORCE MOVE PROJECTILE
--------------------------------------------------

local function forceMoveProjectile(
    obj,
    targetCFrame
)

    --------------------------------------------------
    -- BasePart
    --------------------------------------------------

    if obj:IsA("BasePart") then

        obj.CFrame = targetCFrame

        return
    end

    --------------------------------------------------
    -- Model
    --------------------------------------------------

    if obj:IsA("Model") then

        obj:PivotTo(targetCFrame)

        return
    end

    --------------------------------------------------
    -- Other object containing BaseParts
    --------------------------------------------------

    local root = getProjectileRoot(obj)

    if root then
        root.CFrame = targetCFrame
    end
end

--------------------------------------------------
-- REMOVE TOUCH INTERESTS
--------------------------------------------------

local function removeTouchInterests(obj)

    if obj:IsA("TouchInterest") then
        obj:Destroy()
        return
    end

    for _, descendant in ipairs(
        obj:GetDescendants()
    ) do

        if descendant:IsA("TouchInterest") then
            descendant:Destroy()
        end

    end
end

--------------------------------------------------
-- HANDLE PROJECTILE
--------------------------------------------------

local function handleProjectile(obj)

    if not obj or not obj.Parent then
        return
    end

    if projectileList[obj] then
        return
    end

    local root = getProjectileRoot(obj)

    if not root then
        return
    end

    projectileList[obj] = true

    removeTouchInterests(obj)

    --------------------------------------------------
    -- Spin projectile
    --------------------------------------------------

    local bav = root:FindFirstChildOfClass(
        "BodyAngularVelocity"
    )

    if not bav then

        bav = Instance.new(
            "BodyAngularVelocity"
        )

        bav.MaxTorque = Vector3.new(
            1e6,
            1e6,
            1e6
        )

        bav.AngularVelocity = Vector3.new(
            -40,
            0,
            0
        )

        bav.Parent = root
    end

    bodyAngularList[bav] = true
end

--------------------------------------------------
-- DELETE PROJECTILE
--------------------------------------------------

local function deleteProjectile(obj)

    if not obj or not obj.Parent then
        return
    end

    projectileList[obj] = nil

    obj:Destroy()
end

--------------------------------------------------
-- INITIAL SCAN
--------------------------------------------------

for _, obj in ipairs(
    projectileFolder:GetDescendants()
) do

    if deleteProjectiles[obj.Name] then

        deleteProjectile(obj)

    elseif validProjectiles[obj.Name] == true then

        handleProjectile(obj)

    end
end

--------------------------------------------------
-- NEW PROJECTILES
--------------------------------------------------

projectileFolder.DescendantAdded:Connect(
    function(obj)

        if deleteProjectiles[obj.Name] then

            deleteProjectile(obj)

            return
        end

        if validProjectiles[obj.Name] == true then
            handleProjectile(obj)
        end
    end
)

--------------------------------------------------
-- DELETE LIST
-- EVERY 0.01 SECONDS
--------------------------------------------------

task.spawn(function()

    while true do

        task.wait(0.01)

        for _, obj in ipairs(
            projectileFolder:GetDescendants()
        ) do

            if deleteProjectiles[obj.Name] then
                deleteProjectile(obj)
            end

        end
    end
end)

--------------------------------------------------
-- MAIN LOOP
--------------------------------------------------

RunService.Heartbeat:Connect(
    function()

        --------------------------------------------------
        -- KEEP PROJECTILES SPINNING
        --------------------------------------------------

        for bav in pairs(bodyAngularList) do

            if bav.Parent then

                bav.AngularVelocity = Vector3.new(
                    -40,
                    0,
                    0
                )

            else

                bodyAngularList[bav] = nil

            end
        end

        --------------------------------------------------
        -- FORCE PROJECTILES TO TARGET
        --------------------------------------------------

        for projectile in pairs(projectileList) do

            if not projectile.Parent then

                projectileList[projectile] = nil

                continue
            end

            local position =
                getProjectilePosition(projectile)

            if not position then
                continue
            end

            local target =
                getNearestNPC(position)

            if not target then
                continue
            end

            local hitbox =
                target:FindFirstChild("Hitbox")

            local root =
                target:FindFirstChild(
                    "HumanoidRootPart"
                )

            local targetCFrame = nil

            --------------------------------------------------
            -- Prefer Hitbox
            --------------------------------------------------

            if hitbox
                and hitbox:IsA("BasePart") then

                targetCFrame = hitbox.CFrame

            elseif root
                and root:IsA("BasePart") then

                targetCFrame = root.CFrame

            end

            if targetCFrame then

                forceMoveProjectile(
                    projectile,
                    targetCFrame
                )

            end
        end
    end
)
