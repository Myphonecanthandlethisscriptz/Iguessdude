--------------------------------------------------
-- HELPER FUNCTIONS
--------------------------------------------------

local function getProjectileRoot(obj)
	if obj:IsA("BasePart") then
		return obj
	elseif obj:IsA("Model") then
		return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
	end
	return nil
end

local function removeTouchInterests(obj)
	for _, descendant in ipairs(obj:GetDescendants()) do
		if descendant:IsA("TouchInterest") then
			descendant:Destroy()
		end
	end
end

--------------------------------------------------
-- HP BAR SYSTEM
--------------------------------------------------

local function createHPBar(npc, template, barName)
	if not npc:IsA("Model") then return end

	local humanoid = npc:FindFirstChildOfClass("Humanoid")
	local head = npc:FindFirstChild("Head", true)

	if not humanoid or not head or head:FindFirstChild(barName) then
		return
	end

	local hpBar = template:Clone()
	hpBar.Name = barName

	if hpBar:IsA("BillboardGui") then
		hpBar.Adornee = head
		hpBar.Enabled = true
	end

	local bar = hpBar:FindFirstChild("Bar", true)
	local textLabel = hpBar:FindFirstChild("TextLabel", true)

	if not bar then
		warn("HP bar missing 'Bar':", template:GetFullName())
		hpBar:Destroy()
		return
	end

	hpBar.Parent = head

	local originalYScale = bar.Size.Y.Scale
	local originalYOffset = bar.Size.Y.Offset

	bar.AnchorPoint = Vector2.new(0, bar.AnchorPoint.Y)
	bar.Position = UDim2.new(0, 0, bar.Position.Y.Scale, bar.Position.Y.Offset)

	local function update()
		if not humanoid or not humanoid.Parent then return end

		local health = math.max(humanoid.Health, 0)
		local maxHealth = humanoid.MaxHealth

		if textLabel then
			textLabel.Text = string.format("%d/%d", math.floor(health), math.floor(maxHealth))
		end

		if health <= 0 or maxHealth <= 0 then
			bar.Size = UDim2.new(0, 0, originalYScale, originalYOffset)
			if hpBar:IsA("BillboardGui") then hpBar.Enabled = false end
			return
		end

		if hpBar:IsA("BillboardGui") then hpBar.Enabled = true end
		local percentage = math.clamp(health / maxHealth, 0, 1)
		bar.Size = UDim2.new(percentage, 0, originalYScale, originalYOffset)
	end

	update()

	-- Clean connection management
	local connections = {}
	
	local function cleanup()
		for _, conn in ipairs(connections) do
			conn:Disconnect()
		end
		table.clear(connections)
		if hpBar then hpBar:Destroy() end
	end

	table.insert(connections, humanoid.HealthChanged:Connect(update))
	table.insert(connections, humanoid.Died:Connect(cleanup))
	table.insert(connections, npc.Destroying:Connect(cleanup))
end

local function setupNPC(npc)
	if not npc:IsA("Model") or not npc:FindFirstChildOfClass("Humanoid") then
		return
	end

	if CollectionService:HasTag(npc, "Boss") and npc:IsDescendantOf(enemyFolder) then
		createHPBar(npc, bossTemplate, "BossHPBar")
	elseif npc:IsDescendantOf(enemyFolder) then
		createHPBar(npc, enemyTemplate, "EnemyHPBar")
	elseif npc:IsDescendantOf(friendlyFolder) then
		createHPBar(npc, friendlyTemplate, "FriendlyHPBar")
	end
end

--------------------------------------------------
-- PROJECTILE LOGIC
--------------------------------------------------

local function handleProjectile(obj)
	if activeProjectiles[obj] then return end

	local root = getProjectileRoot(obj)
	if not root then return end

	activeProjectiles[obj] = root
	removeTouchInterests(obj)

	-- Spin Effect using modern AngularVelocity
	local attachment = root:FindFirstChild("SpinAttachment") or Instance.new("Attachment")
	attachment.Name = "SpinAttachment"
	attachment.Parent = root

	local angularVel = root:FindFirstChild("ProjectileSpin") or Instance.new("AngularVelocity")
	angularVel.Name = "ProjectileSpin"
	angularVel.Attachment0 = attachment
	angularVel.MaxTorque = 1000000
	angularVel.AngularVelocity = Vector3.new(-40, 0, 0)
	angularVel.RelativeTo = Enum.RelativeTo.World -- FIX: Corrected Enum reference
	angularVel.Parent = root

	-- Clean up memory on destruction
	obj.Destroying:Once(function()
		activeProjectiles[obj] = nil
	end)
end

local function getNearestNPC(position)
	local nearestNPC = nil
	local nearestDistance = math.huge

	for _, npc in ipairs(enemyFolder:GetChildren()) do
		local humanoid = npc:FindFirstChildOfClass("Humanoid")
		local root = npc:FindFirstChild("HumanoidRootPart")

		if humanoid and humanoid.Health > 0 and root and not npc:GetAttribute("Flying") then
			local distance = (root.Position - position).Magnitude
			if distance < nearestDistance then
				nearestDistance = distance
				nearestNPC = npc
			end
		end
	end

	return nearestNPC
end

--------------------------------------------------
-- INITIALIZATION & LISTENERS
--------------------------------------------------

-- NPC Listeners
local function bindFolder(folder)
	for _, child in ipairs(folder:GetChildren()) do
		task.spawn(setupNPC, child)
	end

	folder.ChildAdded:Connect(function(child)
		task.defer(setupNPC, child)
	end)
end

bindFolder(friendlyFolder)
bindFolder(enemyFolder)

CollectionService:GetInstanceAddedSignal("Boss"):Connect(function(object)
	if object:IsDescendantOf(enemyFolder) then
		setupNPC(object)
	end
end)

-- Process Existing and Incoming Projectiles
local function processProjectile(obj)
	if deleteProjectiles[obj.Name] then
		obj:Destroy()
	elseif validProjectiles[obj.Name] then
		handleProjectile(obj)
	end
end

for _, obj in ipairs(projectileFolder:GetDescendants()) do
	processProjectile(obj)
end

-- Used DescendantAdded to safely catch nested projectile models
projectileFolder.DescendantAdded:Connect(processProjectile)

-- Teleport Up Loop
task.spawn(function()
	while true do
		task.wait(0.2)
		for _, obj in ipairs(projectileFolder:GetDescendants()) do
			if teleportUpProjectiles[obj.Name] then
				if obj:IsA("Model") then
					obj:PivotTo(obj:GetPivot() + Vector3.new(0, 500, 0))
				else
					local root = getProjectileRoot(obj)
					if root then
						root.CFrame = root.CFrame + Vector3.new(0, 500, 0)
					end
				end
			end
		end
	end
end)

--------------------------------------------------
-- MAIN ENGINE LOOP
--------------------------------------------------

RunService.Heartbeat:Connect(function()
	for projectile, root in pairs(activeProjectiles) do
		if not projectile.Parent or not root.Parent then
			activeProjectiles[projectile] = nil
			continue
		end

		local position = root.Position
		local target = getNearestNPC(position)

		if target then
			local targetPart = target:FindFirstChild("Hitbox") or target:FindFirstChild("HumanoidRootPart")
			if targetPart and targetPart:IsA("BasePart") then
				if projectile:IsA("Model") then
					projectile:PivotTo(targetPart.CFrame)
				else
					root.CFrame = targetPart.CFrame
				end
			end
		end
	end
end)
