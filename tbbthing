--------------------------------------------------
-- KEEP PROJECTILE SPINNING
--------------------------------------------------

RunService.Heartbeat:Connect(function()

	for _, object in ipairs(
		projectileFolder:GetDescendants()
	) do

		if validProjectiles[object.Name] then

			local part = nil

			if object:IsA("BasePart") then

				part = object

			elseif object:IsA("Model") then

				part =
					object.PrimaryPart
					or object:FindFirstChildWhichIsA(
						"BasePart",
						true
					)
			end

			if part then

				local spin =
					part:FindFirstChild("ProjectileSpin")

				if spin and spin:IsA("BodyAngularVelocity") then

					spin.MaxTorque =
						Vector3.new(
							1000000,
							1000000,
							1000000
						)

					spin.AngularVelocity =
						Vector3.new(-40, 0, 0)

				end
			end
		end
	end
end)
