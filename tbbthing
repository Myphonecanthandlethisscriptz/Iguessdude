--------------------------------------------------
-- MAIN PROJECTILE LOOP
--------------------------------------------------

RunService.Heartbeat:Connect(
	function()

		--------------------------------------------------
		-- KEEP SPINNING
		--------------------------------------------------

		for bav in pairs(bodyAngularList) do

			if bav.Parent then

				bav.AngularVelocity =
					Vector3.new(
						-40,
						0,
						0
					)

			else

				bodyAngularList[bav] = nil

			end

		end


		--------------------------------------------------
		-- MOVE PROJECTILES
		--------------------------------------------------

		for projectile in pairs(
			projectileList
		) do

			if not projectile.Parent then

				projectileList[projectile] = nil

				continue

			end

			local position =
				getProjectilePosition(
					projectile
				)

			if not position then
				continue
			end

			local target =
				getNearestNPC(position)

			if not target then
				continue
			end

			--------------------------------------------------
			-- HITBOX FIRST
			--------------------------------------------------

			local hitbox =
				target:FindFirstChild(
					"Hitbox"
				)

			--------------------------------------------------
			-- ROOT SECOND
			--------------------------------------------------

			local root =
				target:FindFirstChild(
					"HumanoidRootPart"
				)

			local targetCFrame = nil

			if hitbox
				and hitbox:IsA("BasePart") then

				targetCFrame =
					hitbox.CFrame

			elseif root
				and root:IsA("BasePart") then

				targetCFrame =
					root.CFrame

			end

			--------------------------------------------------
			-- MOVE
			--------------------------------------------------

			if targetCFrame then

				forceMoveProjectile(
					projectile,
					targetCFrame
				)

			end

		end

	end
)
