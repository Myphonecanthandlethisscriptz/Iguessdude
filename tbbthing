--------------------------------------------------
-- CHAT COMMAND SYSTEM
--------------------------------------------------
local function findProjectileKey(targetTable, lowerInput)
    for key in pairs(targetTable) do
        if string.lower(key) == lowerInput then
            return key
        end
    end
    return nil
end

local function toggleProjectileState(inputName)
    local lowerInput = string.lower(inputName)
    local validKey = findProjectileKey(validProjectiles, lowerInput)
    local deleteKey = findProjectileKey(deleteProjectiles, lowerInput)

    if validKey then
        validProjectiles[validKey] = not validProjectiles[validKey]
        print(string.format("[Toggle] validProjectiles['%s'] set to: %s", validKey, tostring(validProjectiles[validKey])))
    end

    if deleteKey then
        deleteProjectiles[deleteKey] = not deleteProjectiles[deleteKey]
        print(string.format("[Toggle] deleteProjectiles['%s'] set to: %s", deleteKey, tostring(deleteProjectiles[deleteKey])))
    end

    if not validKey and not deleteKey then
        warn(string.format("[Toggle Error] Projectile '%s' not found in configuration tables.", inputName))
    end
end

local function setDeleteState(inputName)
    local lowerInput = string.lower(inputName)
    local deleteKey = findProjectileKey(deleteProjectiles, lowerInput)
    local validKey = findProjectileKey(validProjectiles, lowerInput)

    local targetKey = deleteKey or validKey or inputName

    if validKey then
        validProjectiles[validKey] = false
    end

    deleteProjectiles[targetKey] = not (deleteProjectiles[targetKey] or false)
    print(string.format("[Delete Command] deleteProjectiles['%s'] set to: %s", targetKey, tostring(deleteProjectiles[targetKey])))
end

local function setValidState(inputName)
    local lowerInput = string.lower(inputName)
    local validKey = findProjectileKey(validProjectiles, lowerInput)
    local deleteKey = findProjectileKey(deleteProjectiles, lowerInput)

    local targetKey = validKey or deleteKey or inputName

    if deleteKey then
        deleteProjectiles[deleteKey] = false
    end

    validProjectiles[targetKey] = not (validProjectiles[targetKey] or false)
    print(string.format("[Valid Command] validProjectiles['%s'] set to: %s", targetKey, tostring(validProjectiles[targetKey])))
end

task.spawn(function()
    local localPlayer = Players.LocalPlayer or Players:GetPropertyChangedSignal("LocalPlayer"):Wait()

    localPlayer.Chatted:Connect(function(msg)
        local split = string.split(msg, " ")
        local cmd = split[1] and string.lower(split[1])
        local targetName = split[2]

        if cmd == "/god" then
            godModeActive = not godModeActive
            if godModeActive then
                for _, desc in ipairs(friendlyFolder:GetDescendants()) do
                    if desc:IsA("Model") then removeFriendlyRoot(desc) end
                end
            end
        elseif targetName then
            if cmd == "/toggle" then
                toggleProjectileState(targetName)
            elseif cmd == "/delete" or cmd == "/del" then
                setDeleteState(targetName)
            elseif cmd == "/valid" then
                setValidState(targetName)
            end
        end
    end)
end)

--------------------------------------------------
-- HELPER FUNCTIONS
--------------------------------------------------
local function getProjectileRoot(obj)
    if obj:IsA("BasePart") then
        return obj
    elseif obj:IsA("Model") then
        if obj.PrimaryPart then return obj.PrimaryPart end
        return obj:FindFirstChildWhichIsA("BasePart", false)
    end
    return nil
end

local function removeTouchInterests(obj)
    for _, descendant in ipairs(obj:GetDescendants()) do
        if descendant:IsA("TouchInterest") then
            descendant:Destroy()
        end
    end
end

--------------------------------------------------
-- TARGETING
--------------------------------------------------
local function getRedBaseTarget()
    local baseFolder = npcFolder:FindFirstChild("BaseFolder") or Workspace:FindFirstChild("BaseFolder")
    local redBase = baseFolder and baseFolder:FindFirstChild("Red Base") or Workspace:FindFirstChild("Red Base")

    if not redBase then return nil end

    if redBase:IsA("BasePart") then
        return redBase
    end

    local targetPart = redBase:FindFirstChild("MainHitbox")
        or redBase:FindFirstChild("Hitbox")
        or redBase:FindFirstChild("HumanoidRootPart")
        or redBase:FindFirstChild("Base")
        or redBase:FindFirstChild("Core")

    if targetPart and targetPart:IsA("BasePart") then
        return targetPart
    end

    if redBase:IsA("Model") then
        if redBase.PrimaryPart then
            return redBase.PrimaryPart
        end
        return redBase:FindFirstChildWhichIsA("BasePart", false)
    end

    return nil
end

local function getNearestTarget(position)
    local nearestPart = nil
    local nearestDistance = math.huge

    for _, npc in ipairs(enemyFolder:GetChildren()) do
        if npc:IsA("Model") then
            local humanoid = npc:FindFirstChildOfClass("Humanoid")
            local root = npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart
            local isIgnored = ignoredNPCs[npc.Name] or npc:GetAttribute("Ignored")

            if humanoid and humanoid.Health > 0 and root and not isIgnored then
                local distance = (root.Position - position).Magnitude
                if distance < nearestDistance then
                    nearestDistance = distance
                    nearestPart = npc:FindFirstChild("Hitbox") or root
                end
            end
        end
    end

    if nearestPart then
        return nearestPart
    end

    return getRedBaseTarget()
end

--------------------------------------------------
-- WAIT TO MOVE UI SYSTEM
--------------------------------------------------
local function createWaitToMoveUI(npc)
    if not npc:IsA("Model") then return end

    local head = npc:FindFirstChild("Head") 
        or npc.PrimaryPart 
        or npc:FindFirstChildWhichIsA("BasePart", false)

    if not head or head:FindFirstChild(UI_WAIT_TO_MOVE_NAME) then return end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = UI_WAIT_TO_MOVE_NAME
    billboard.Adornee = head
    billboard.Size = UDim2.new(0, 160, 0, 30)
    billboard.StudsOffset = Vector3.new(0, 4.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Enabled = false

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.TextColor3 = Color3.fromRGB(255, 230, 80)
    textLabel.TextStrokeTransparency = 0
    textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextSize = 14
    textLabel.Parent = billboard

    billboard.Parent = head

    local connections = {}

    local function cleanup()
        for _, conn in ipairs(connections) do conn:Disconnect() end
        table.clear(connections)
        if billboard and billboard.Parent then billboard:Destroy() end
    end

    local function updateText()
        local waitValue = npc:GetAttribute("WaitToMove")
        if waitValue ~= nil then
            textLabel.Text = string.format("WaitToMove: %s", tostring(waitValue))
            billboard.Enabled = true
        else
            billboard.Enabled = false
        end
    end

    table.insert(connections, npc:GetAttributeChangedSignal("WaitToMove"):Connect(updateText))
    updateText()

    local humanoid = npc:FindFirstChildOfClass("Humanoid")
    if humanoid then
        table.insert(connections, humanoid.Died:Connect(cleanup))
    end
    table.insert(connections, npc.Destroying:Connect(cleanup))
end

--------------------------------------------------
-- HP BAR SYSTEM (FIRESIGNAL METHOD)
--------------------------------------------------
local function GetHealthbarType(npc, defaultBarType)
    if CollectionService:HasTag(npc, "Friendly") then
        return "Friendly"
    end
    if CollectionService:HasTag(npc, "Boss") then
        return "Boss"
    end
    return defaultBarType
end

local function ApplyHealthbarToNPC(npc, defaultBarType)
    if npc and not ProcessedNPCs[npc] then
        ProcessedNPCs[npc] = true
        task.spawn(function()
            local head = npc:WaitForChild("Head", 5)
            local humanoid = npc:WaitForChild("Humanoid", 5)

            if head and humanoid and AddHPBars then
                local barType = GetHealthbarType(npc, defaultBarType)

                pcall(function()
                    firesignal(AddHPBars.OnClientEvent, npc, barType, head)
                end)
            else
                ProcessedNPCs[npc] = nil
            end
        end)
    end
end

--------------------------------------------------
-- PROJECTILE LOGIC
--------------------------------------------------
local function handleProjectile(obj)
    if activeProjectiles[obj] then return end

    local root = getProjectileRoot(obj)
    if not root then return end

    activeProjectiles[obj] = root
    removeTouchInterests(obj)

    local attachment = root:FindFirstChild("SpinAttachment") or Instance.new("Attachment")
    attachment.Name = "SpinAttachment"
    attachment.Parent = root

    local angularVel = root:FindFirstChild("ProjectileSpin") or Instance.new("AngularVelocity")
    angularVel.Name = "ProjectileSpin"
    angularVel.Attachment0 = attachment
    angularVel.MaxTorque = 1000000
    angularVel.AngularVelocity = Vector3.new(-40, 0, 0)
    angularVel.RelativeTo = Enum.RelativeTo.World
    angularVel.Parent = root

    obj.Destroying:Once(function()
        activeProjectiles[obj] = nil
    end)
end

local function processProjectile(obj)
    task.defer(function()
        if not obj or not obj.Parent then return end

        if deleteProjectiles[obj.Name] == true then
            obj:Destroy()
        elseif validProjectiles[obj.Name] == true then
            handleProjectile(obj)
        end
    end)
end

