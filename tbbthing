--------------------------------------------------
-- HELPER FUNCTIONS
--------------------------------------------------

local function findChild(parent, name)
	return parent:FindFirstChild(name, true)
end

local function getProjectileRoot(obj)
	if obj:IsA("BasePart") then
		return obj
	elseif obj:IsA("Model") then
		return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
	end
	return obj:FindFirstChildWhichIsA("BasePart", true)
end

local function getProjectilePosition(obj)
	if obj:IsA("BasePart") then
		return obj.Position
	elseif obj:IsA("Model") then
		return obj:GetPivot().Position
	end
	local root = getProjectileRoot(obj)
	return root and root.Position or nil
end

local function removeTouchInterests(obj)
	if obj:IsA("TouchInterest") then
		obj:Destroy()
		return
	end
	for _, descendant in ipairs(obj:GetDescendants()) do
		if descendant:IsA("TouchInterest") then
			descendant:Destroy()
		end
	end
end

--------------------------------------------------
-- HP BAR SYSTEM
--------------------------------------------------

local function createHPBar(npc, template, barName)
	if not npc:IsA("Model") then return end

	local humanoid = npc:FindFirstChildOfClass("Humanoid")
	local head = npc:FindFirstChild("Head", true)

	if not humanoid or not head or head:FindFirstChild(barName) then
		return
	end

	local hpBar = template:Clone()
	hpBar.Name = barName

	if hpBar:IsA("BillboardGui") then
		hpBar.Adornee = head
		hpBar.Enabled = true
	end

	hpBar.Parent = head

	local bar = findChild(hpBar, "Bar")
	local textLabel = findChild(hpBar, "TextLabel")

	if not bar then
		warn("HP bar missing 'Bar':", template:GetFullName())
		return
	end

	local originalYScale = bar.Size.Y.Scale
	local originalYOffset = bar.Size.Y.Offset

	bar.AnchorPoint = Vector2.new(0, bar.AnchorPoint.Y)
	bar.Position = UDim2.new(0, 0, bar.Position.Y.Scale, bar.Position.Y.Offset)

	local function update()
		if not humanoid.Parent then return end

		local health = humanoid.Health
		local maxHealth = humanoid.MaxHealth

		if textLabel then
			textLabel.Text = math.floor(math.max(health, 0)) .. "/" .. math.floor(maxHealth)
		end

		if health <= 0 or maxHealth <= 0 then
			bar.Size = UDim2.new(0, 0, originalYScale, originalYOffset)
			if hpBar:IsA("BillboardGui") then
				hpBar.Enabled = false
			end
			return
		end

		if hpBar:IsA("BillboardGui") then
			hpBar.Enabled = true
		end

		local percentage = math.clamp(health / maxHealth, 0, 1)
		bar.Size = UDim2.new(percentage, 0, originalYScale, originalYOffset)
	end

	update()

	local healthConn, diedConn
	healthConn = humanoid.HealthChanged:Connect(update)
	diedConn = humanoid.Died:Connect(function()
		bar.Size = UDim2.new(0, 0, originalYScale, originalYOffset)
		if hpBar:IsA("BillboardGui") then
			hpBar.Enabled = false
		end
		healthConn:Disconnect()
		diedConn:Disconnect()
	end)
end

local function setupNPC(npc)
	if not npc:IsA("Model") or not npc:FindFirstChildOfClass("Humanoid") then
		return
	end

	if CollectionService:HasTag(npc, "Boss") then
		if npc:IsDescendantOf(enemyFolder) then
			createHPBar(npc, bossTemplate, "BossHPBar")
		end
		return
	end

	if npc:IsDescendantOf(enemyFolder) then
		createHPBar(npc, enemyTemplate, "EnemyHPBar")
		return
	end

	if npc:IsDescendantOf(friendlyFolder) then
		createHPBar(npc, friendlyTemplate, "FriendlyHPBar")
	end
end

--------------------------------------------------
-- PROJECTILE LOGIC
--------------------------------------------------

local function forceMoveProjectile(obj, targetCFrame)
	if obj:IsA("BasePart") then
		obj.CFrame = targetCFrame
	elseif obj:IsA("Model") then
		obj:PivotTo(targetCFrame)
	else
		local root = getProjectileRoot(obj)
		if root then
			root.CFrame = targetCFrame
		end
	end
end

local function deleteProjectile(obj)
	if not obj or not obj.Parent then return end
	projectileList[obj] = nil
	obj:Destroy()
end

local function handleProjectile(obj)
	if not obj or not obj.Parent or projectileList[obj] then
		return
	end

	local root = getProjectileRoot(obj)
	if not root then return end

	projectileList[obj] = true
	removeTouchInterests(obj)

	local bav = root:FindFirstChild("ProjectileSpin")
	if not bav then
		bav = Instance.new("BodyAngularVelocity")
		bav.Name = "ProjectileSpin"
		bav.MaxTorque = Vector3.new(1000000, 1000000, 1000000)
		bav.AngularVelocity = Vector3.new(-40, 0, 0)
		bav.Parent = root
	end

	bodyAngularList[bav] = true
end

local function getNearestNPC(position)
	local nearestNPC = nil
	local nearestDistance = math.huge

	for _, npc in ipairs(enemyFolder:GetChildren()) do
		local humanoid = npc:FindFirstChildOfClass("Humanoid")
		local root = npc:FindFirstChild("HumanoidRootPart")
		local isFlying = npc:GetAttribute("Flying") ~= nil

		if humanoid and humanoid.Health > 0 and root and not isFlying then
			local distance = (root.Position - position).Magnitude
			if distance < nearestDistance then
				nearestDistance = distance
				nearestNPC = npc
			end
		end
	end

	return nearestNPC
end

--------------------------------------------------
-- INITIALIZATION & LISTENERS
--------------------------------------------------

-- Initial NPC Scan
local function scanFolderForNPCs(folder)
	for _, object in ipairs(folder:GetDescendants()) do
		if object:IsA("Model") and object:FindFirstChildOfClass("Humanoid") then
			task.spawn(setupNPC, object)
		end
	end
end

scanFolderForNPCs(friendlyFolder)
scanFolderForNPCs(enemyFolder)

-- Dynamic NPC Listeners
friendlyFolder.DescendantAdded:Connect(function(object)
	task.wait(0.1)
	if object:IsA("Model") then setupNPC(object) end
end)

enemyFolder.DescendantAdded:Connect(function(object)
	task.wait(0.1)
	if object:IsA("Model") then setupNPC(object) end
end)

CollectionService:GetInstanceAddedSignal("Boss"):Connect(function(object)
	task.wait(0.1)
	if object:IsDescendantOf(enemyFolder) then setupNPC(object) end
end)

-- Background Safety NPC Rescan
task.spawn(function()
	while true do
		task.wait(1)
		scanFolderForNPCs(friendlyFolder)
		scanFolderForNPCs(enemyFolder)
	end
end)

-- Initial Projectiles
for _, obj in ipairs(projectileFolder:GetDescendants()) do
	if deleteProjectiles[obj.Name] then
		deleteProjectile(obj)
	elseif validProjectiles[obj.Name] then
		handleProjectile(obj)
	end
end

-- Dynamic Projectile Listener
projectileFolder.DescendantAdded:Connect(function(obj)
	task.defer(function()
		if not obj.Parent then return end

		if deleteProjectiles[obj.Name] then
			deleteProjectile(obj)
			return
		end

		if validProjectiles[obj.Name] then
			handleProjectile(obj)
		end
	end)
end)

-- Teleport Up Loop
task.spawn(function()
	while true do
		task.wait(0.1)
		for _, obj in ipairs(projectileFolder:GetDescendants()) do
			if teleportUpProjectiles[obj.Name] then
				if obj:IsA("Model") then
					obj:PivotTo(obj:GetPivot() + Vector3.new(0, 500, 0))
				else
					local root = getProjectileRoot(obj)
					if root then
						root.CFrame = root.CFrame + Vector3.new(0, 500, 0)
					end
				end
			end
		end
	end
end)

--------------------------------------------------
-- MAIN ENGINE LOOP
--------------------------------------------------

RunService.Heartbeat:Connect(function()
	-- Maintain projectile spin
	for bav in pairs(bodyAngularList) do
		if bav.Parent then
			bav.AngularVelocity = Vector3.new(-40, 0, 0)
		else
			bodyAngularList[bav] = nil
		end
	end

	-- Move projectiles toward nearest enemies
	for projectile in pairs(projectileList) do
		if not projectile.Parent then
			projectileList[projectile] = nil
			continue
		end

		local position = getProjectilePosition(projectile)
		if not position then continue end

		local target = getNearestNPC(position)
		if not target then continue end

		local hitbox = target:FindFirstChild("Hitbox")
		local root = target:FindFirstChild("HumanoidRootPart")
		local targetCFrame

		if hitbox and hitbox:IsA("BasePart") then
			targetCFrame = hitbox.CFrame
		elseif root and root:IsA("BasePart") then
			targetCFrame = root.CFrame
		end

		if targetCFrame then
			forceMoveProjectile(projectile, targetCFrame)
		end
	end
end)
