--------------------------------------------------
-- FIND NPC TARGET
--------------------------------------------------

local function getNearestNPC(position)

	local nearestNPC = nil
	local nearestDistance = math.huge

	for _, npc in ipairs(enemyFolder:GetChildren()) do

		if npc:IsA("Model") then

			local humanoid = npc:FindFirstChildOfClass("Humanoid")

			if humanoid and humanoid.Health > 0 then

				-- Flying NPCs are NOT valid targets.
				-- Their parts are NOT deleted.
				if not npc:GetAttribute("Flying") then

					local targetPart =
						npc:FindFirstChild("Hitbox", true)
						or npc:FindFirstChild("HumanoidRootPart", true)

					if targetPart and targetPart:IsA("BasePart") then

						local distance =
							(position - targetPart.Position).Magnitude

						if distance < nearestDistance then
							nearestDistance = distance
							nearestNPC = npc
						end

					end
				end
			end
		end
	end

	return nearestNPC
end


--------------------------------------------------
-- REMOVE TOUCH INTEREST
--------------------------------------------------

local function removeTouchInterest(object)

	for _, descendant in ipairs(object:GetDescendants()) do

		if descendant:IsA("TouchTransmitter") then
			descendant:Destroy()
		elseif descendant.Name == "TouchInterest" then
			descendant:Destroy()
		end

	end

	if object:IsA("BasePart") then

		for _, child in ipairs(object:GetChildren()) do

			if child:IsA("TouchTransmitter")
				or child.Name == "TouchInterest" then

				child:Destroy()
			end

		end
	end
end


--------------------------------------------------
-- SPIN PROJECTILE
--------------------------------------------------

local function addSpin(part)

	if not part:IsA("BasePart") then
		return
	end

	local existing = part:FindFirstChild("ProjectileSpin")

	if existing then
		existing:Destroy()
	end

	local angularVelocity =
		Instance.new("BodyAngularVelocity")

	angularVelocity.Name = "ProjectileSpin"

	angularVelocity.MaxTorque =
		Vector3.new(1000000, 1000000, 1000000)

	angularVelocity.AngularVelocity =
		Vector3.new(-40, 0, 0)

	angularVelocity.Parent = part

	return angularVelocity
end


--------------------------------------------------
-- PROCESS PROJECTILE
--------------------------------------------------

local function processProjectile(object)

	if not object then
		return
	end

	--------------------------------------------------
	-- DELETE LIST
	--------------------------------------------------

	if deleteProjectiles[object.Name] then

		object:Destroy()

		return
	end


	--------------------------------------------------
	-- VALID PROJECTILE
	--------------------------------------------------

	if not validProjectiles[object.Name] then
		return
	end


	--------------------------------------------------
	-- FIND MAIN PART
	--------------------------------------------------

	local mainPart = nil

	if object:IsA("BasePart") then

		mainPart = object

	elseif object:IsA("Model") then

		mainPart =
			object.PrimaryPart
			or object:FindFirstChildWhichIsA(
				"BasePart",
				true
			)

	end

	if not mainPart then
		return
	end


	--------------------------------------------------
	-- REMOVE TOUCH INTEREST
	--------------------------------------------------

	removeTouchInterest(object)


	--------------------------------------------------
	-- SPIN
	--------------------------------------------------

	addSpin(mainPart)


	--------------------------------------------------
	-- FIND TARGET
	--------------------------------------------------

	local target = getNearestNPC(
		mainPart.Position
	)

	if not target then
		return
	end


	--------------------------------------------------
	-- TARGET PART
	--------------------------------------------------

	local targetPart =
		target:FindFirstChild("Hitbox", true)
		or target:FindFirstChild("HumanoidRootPart", true)

	if not targetPart or not targetPart:IsA("BasePart") then
		return
	end


	--------------------------------------------------
	-- MOVE PROJECTILE
	--------------------------------------------------

	if object:IsA("BasePart") then

		object.CFrame =
			CFrame.new(targetPart.Position)

	elseif object:IsA("Model") then

		object:PivotTo(
			CFrame.new(targetPart.Position)
		)

	end
end


